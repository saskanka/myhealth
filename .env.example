# Copy to .env and fill values
GARMIN_CLIENT_ID=your_client_id_here
GARMIN_CLIENT_SECRET=your_client_secret_here
GARMIN_REDIRECT_URI=http://localhost:3000/auth/callback
SESSION_SECRET=change_this_secret
# Optional override URLs
GARMIN_TOKEN_URL=https://connect.garmin.com/oauth/token
GARMIN_ACTIVITIES_URL=https://connect.garmin.com/modern/proxy/activitylist-service/activities
# OAuth authorization endpoint (replace if Garmin uses a different URL)
GARMIN_AUTH_URL=https://connect.garmin.com/oauth/authorize
# Optional scope (adjust per Garmin docs)
GARMIN_SCOPE=activity:read
# When set to true the server will return a built-in mock activities JSON at /api/activities
MOCK_ACTIVITIES=false
